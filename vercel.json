{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/ab"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|svg|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\", </llms.txt>; rel=\"service-doc\"; type=\"text/markdown\""
        }
      ]
    }
  ]
}
